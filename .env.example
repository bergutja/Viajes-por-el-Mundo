# Proxy de la red. Completar localmente si es necesario.
HTTPS_PROXY=

# Clave del servidor para embeddings y respuestas RAG. Nunca usar en web/.
OPENAI_API_KEY=

# Modelos del RAG, siguiendo el ejemplo ../iagen-api-casos/rag.py.
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_UMBRAL=0.30
RAG_K=4
